# ── Modo de instancia ────────────────────────────────────────────────────────
# La aplicación selecciona el modo automáticamente:
# - single-tenant: cualquier variable de la sección single tiene un valor.
# - multi-tenant: todas las variables de la sección single están ausentes o vacías.
#
# ── Exclusivas de single-tenant ───────────────────────────────────────────────
# El favicon y las credenciales de Mercado Pago se configuran después del build.
DATABASE_URL=
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_EXPIRES_AT=
MP_REFRESH_TOKEN=
NEXT_PUBLIC_INSTANCE_NAME=
NEXT_PUBLIC_INSTANCE_DESCRIPTION=
NEXT_PUBLIC_FAVICON_URL=
INSTANCE_CONTACT_EMAIL=
INSTANCE_WEB_URL=
NEXT_PUBLIC_HUE=
NEXT_PUBLIC_SATURATION=
NEXT_PUBLIC_SITE_URL=

# ── Compartidas entre single y multi-tenant ──────────────────────────────────
# Todas son requeridas.
AUTH_SECRET=
BARCODE_SECRET=
CREDENTIALS_SIGNING_SECRET=
GUIDE_URL=
PLUTO_URL=
RESEND_API_KEY=
RESEND_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEXT_PUBLIC_S3_BUCKET_URL=

# ── Multi-tenant ─────────────────────────────────────────────────────────────
# Sólo para el despliegue compartido. No configurar ninguna variable de la
# sección single-tenant en ese despliegue.
# Todas son requeridas en una instancia multi-tenant.
CONTROL_DATABASE_URL=
# Bootstrap del primer control admin (npm run control:seed-admin)
CONTROL_BOOTSTRAP_USERNAME=
CONTROL_BOOTSTRAP_EMAIL=
CONTROL_BOOTSTRAP_PASSWORD=
ROOT_DOMAIN=
NEON_API_KEY=
NEON_PROJECT_NAME=

# Personalizan la landing del dominio raíz.
MULTI_TENANT_CONTACT_EMAIL=contacto@example.com
MULTI_TENANT_LANDING_NAME=Nuestros Tickets
MULTI_TENANT_LANDING_DESCRIPTION=Todas tus experiencias, en un solo lugar.
MULTI_TENANT_LANDING_COLOR="#7c3aed"
