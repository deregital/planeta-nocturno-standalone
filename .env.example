# ── Modo de instancia ────────────────────────────────────────────────────────
# La aplicación selecciona el modo automáticamente:
# - single-tenant: cualquier variable de la sección single tiene un valor.
# - multi-tenant: todas las variables de la sección single están ausentes o vacías.
#
# ── Exclusivas de single-tenant ───────────────────────────────────────────────
# Requeridas para iniciar: DATABASE_URL, NEXT_PUBLIC_INSTANCE_NAME e
# INSTANCE_WEB_URL. Las restantes son opcionales según las funciones habilitadas.
DATABASE_URL=
MP_ACCESS_TOKEN=
MP_SECRET_KEY=
MP_REFRESH_TOKEN=
NEXT_PUBLIC_INSTANCE_NAME=
NEXT_PUBLIC_INSTANCE_DESCRIPTION=
NEXT_PUBLIC_FAVICON_URL=
INSTANCE_CONTACT_EMAIL=
INSTANCE_WEB_URL=
NEXT_PUBLIC_HUE=
NEXT_PUBLIC_SATURATION=
# Compatibilidad temporal. Preferir INSTANCE_WEB_URL.
NEXT_PUBLIC_SITE_URL=

# ── Compartidas entre single y multi-tenant ──────────────────────────────────
AUTH_SECRET=
BARCODE_SECRET=
CREDENTIALS_SIGNING_SECRET=
GUIDE_URL=
PLUTO_URL=
RESEND_API_KEY=
RESEND_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEXT_PUBLIC_S3_BUCKET_URL=

# ── Multi-tenant ─────────────────────────────────────────────────────────────
# Sólo para el despliegue compartido. No configurar ninguna variable de la
# sección single-tenant en ese despliegue.
# Las cuatro variables siguientes son requeridas para iniciar.
CONTROL_DATABASE_URL=
ROOT_DOMAIN=
NEON_API_KEY=
NEON_PROJECT_NAME=

# Opcionales. Personalizan la landing del dominio raíz.
MULTI_TENANT_LANDING_NAME=Nuestros Tickets
MULTI_TENANT_LANDING_DESCRIPTION=Todas tus experiencias, en un solo lugar.
MULTI_TENANT_LANDING_COLOR="#7c3aed"

# ── Tests E2E (Playwright) ────────────────────────────────────────────────────
# URL base del servidor bajo prueba (default: https://localhost:3000)
TEST_BASE_URL=https://localhost:3000

# Credenciales del usuario administrador seed para los tests
TEST_SEED_USER_NAME=
TEST_SEED_USER_PASSWORD=

# ── Tests de MercadoPago ──────────────────────────────────────────────────────
# Para tests de checkout real con cuentas de prueba de MP:
#
#   1. Ingresá a https://www.mercadopago.com.ar/developers/panel/app
#   2. Seleccioná tu aplicación → Test accounts
#   3. Creá una cuenta de prueba tipo "Comprador" (o usá la creada automáticamente)
#   4. Copiá el usuario y contraseña de esa cuenta aquí
#
# IMPORTANTE: MP_ACCESS_TOKEN debe ser el ACCESS TOKEN DE PRUEBA (no producción).
# El token de prueba se encuentra en: panel MP → tu app → Credenciales de prueba.

# Usuario de la cuenta de prueba compradora (email o nombre de usuario de ML)
MP_CHECKOUT_USER=

# Contraseña de la cuenta de prueba compradora (visible en el panel de MP → Test accounts)
MP_CHECKOUT_PASSWORD=

# Código de verificación de 6 dígitos si MP solicita confirmación de email/SMS
# (lo encontrás en el panel de MP bajo la cuenta de prueba → "Verification code")
MP_CHECKOUT_OTP=

# Forma de pago en el checkout de prueba: 'balance' (saldo en cuenta) | 'card'
MP_CHECKOUT_PAY_WITH=balance

# Path a un archivo JSON con el estado de sesión guardado de MP (evita OTP repetidos)
# Para generarlo: npx playwright test save-mp-storage --headed --project=chromium
# MP_STORAGE_STATE=playwright/.auth/mp-user.json

# Modo para ingresar el OTP: 'terminal' (readline) | 'browser' (pausa en el browser)
# MP_CHECKOUT_OTP_MODE=terminal
